{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Landlock security policy schema",
  "type": "object",
  "definitions": {
    "uint64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "abi": {
      "description": "A positive requested Landlock ABI version. Values newer than this implementation supports are accepted and clamped to its latest supported ABI.",
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "accessFs": {
      "description": "A filesystem access right or ABI-relative group. Each concrete right must be supported by the effective policy ABI; groups remain valid at every ABI and resolve to its supported subset. This semantic constraint is enforced by the parser because Draft 7 cannot derive it from the root ABI.",
      "type": "string",
      "enum": [
        "abi.all",
        "abi.read_execute",
        "abi.read_write",
        "execute",
        "write_file",
        "read_file",
        "read_dir",
        "remove_dir",
        "remove_file",
        "make_char",
        "make_dir",
        "make_reg",
        "make_sock",
        "make_fifo",
        "make_block",
        "make_sym",
        "refer",
        "truncate",
        "ioctl_dev"
      ]
    },
    "accessNet": {
      "description": "A network access right or ABI-relative group. Each concrete right must be supported by the effective policy ABI; groups remain valid at every ABI and may resolve empty before network support. This semantic constraint is enforced by the parser because Draft 7 cannot derive it from the root ABI.",
      "type": "string",
      "enum": [
        "abi.all",
        "bind_tcp",
        "connect_tcp"
      ]
    },
    "scope": {
      "description": "A scope or ABI-relative group. Each concrete scope must be supported by the effective policy ABI; groups remain valid at every ABI and may resolve empty before scope support. This semantic constraint is enforced by the parser because Draft 7 cannot derive it from the root ABI.",
      "type": "string",
      "enum": [
        "abi.all",
        "abstract_unix_socket",
        "signal"
      ]
    }
  },
  "properties": {
    "abi": {
      "description": "The mandatory Landlock ABI version used to resolve access groups.",
      "allOf": [
        {
          "$ref": "#/definitions/abi"
        }
      ]
    },
    "variable": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "literal": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "ruleset": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "handledAccessFs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/accessFs"
            }
          },
          "handledAccessNet": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/accessNet"
            }
          },
          "scoped": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/scope"
            }
          }
        },
        "minProperties": 1,
        "additionalProperties": false
      }
    },
    "pathBeneath": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "allowedAccess": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/accessFs"
            }
          },
          "parent": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "allowedAccess",
          "parent"
        ],
        "additionalProperties": false
      }
    },
    "netPort": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "allowedAccess": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/accessNet"
            }
          },
          "port": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/uint64"
            }
          }
        },
        "required": [
          "allowedAccess",
          "port"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "abi"
  ],
  "anyOf": [
    {
      "required": [
        "variable"
      ]
    },
    {
      "required": [
        "ruleset"
      ]
    },
    {
      "required": [
        "pathBeneath"
      ]
    },
    {
      "required": [
        "netPort"
      ]
    }
  ],
  "additionalProperties": false
}
